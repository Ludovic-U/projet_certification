generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

// la config de l'app est un fichier json ..\backend\config\app-config.json

model User {
  userId    Int      @id @default(autoincrement())
  username  String   @unique
  firstname String
  lastname  String
  password  String?
  email     String   @unique
  createdAt DateTime @default(now())

  userSessions UserSession[]

  roles               UserRole[] // Existing relation
  taskAssignments     TaskAssignment[] // Existing relation
  clientUserRoles     ClientUserRole[] // Existing relation
  projects            Project[]        @relation("ProjectManager") // Existing relation
  subActionsPiloteGrt SubAction[]      @relation("PiloteGrt") // Fixed relation
}

model UserSession {
  sessionId Int      @id @default(autoincrement())
  userId    Int
  tokenHash String // Stocke le hash du token JWT
  createdAt DateTime @default(now())
  expiresAt DateTime
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model Client {
  clientId        Int              @id @default(autoincrement())
  clientName      String           @unique
  description     String?
  secteur         String?
  statusJuridique String?
  createdAt       DateTime         @default(now())
  projects        Project[]
  userRoles       ClientUserRole[]
}

model ClientUserRole {
  clientId  Int
  userId    Int
  isManager Boolean @default(false) //TODO: à changer
  position  String?

  client Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([clientId, userId]) // Composite primary key
}

model Role {
  roleId   Int     @id @default(autoincrement())
  roleName String  @unique
  roleDesc String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [userId])
  role Role @relation(fields: [roleId], references: [roleId])

  @@id([userId, roleId]) // Composite primary key
}

model Permission {
  permId   Int     @id @default(autoincrement())
  permName String  @unique
  permDesc String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId Int
  permId Int

  role       Role       @relation(fields: [roleId], references: [roleId])
  permission Permission @relation(fields: [permId], references: [permId])

  @@id([roleId, permId]) // Composite primary key
}

model Project {
  projectId      Int       @id @default(autoincrement())
  projectName    String    @unique
  startDate      DateTime?
  endDate        DateTime?
  projectManager Int
  projectStage   String?
  projectStatus  String?
  projectDesc    String?
  createdAt      DateTime  @default(now())
  clientId       Int
  SWOT_strength     String?
  SWOT_weakness     String?
  SWOT_opportunity  String?
  SWOT_threat       String?

  client  Client   @relation(fields: [clientId], references: [clientId])
  manager User     @relation("ProjectManager", fields: [projectManager], references: [userId])
  actions Action[]
  tasks  Task[]

  types           Type[]            @relation("ProjectType")
  questions       Question[]        @relation("ProjectQuestion")
  responses       Response[]
  FinanceurProjet FinanceurProjet[]
}

model Financeur {
  financeurId     Int               @id @default(autoincrement())
  FinanceurName   String            @unique
  FinanceurProjet FinanceurProjet[]
}

// The FinanceurProjet model serves as a join table to associate projects with financeurs and specify the percentage of funding provided by each financeur.
model FinanceurProjet {
  pourcentage Int
  montant     Int
  projectId   Int
  financeurId Int

  project   Project   @relation(fields: [projectId], references: [projectId])
  financeur Financeur @relation(fields: [financeurId], references: [financeurId])

  @@id([projectId, financeurId]) // Composite primary key  
}

model Action {
  actionId   Int      @id @default(autoincrement())
  actionName String
  actionObj  String?
  projectId  Int
  startDate  DateTime

  project    Project     @relation(fields: [projectId], references: [projectId])
  subActions SubAction[]
}

model SubAction {
  subActionId Int      @id @default(autoincrement())
  actionId    Int
  description String?
  piloteGrtId Int?
  startDate   DateTime
  endDate     DateTime

  action       Action        @relation(fields: [actionId], references: [actionId])
  piloteGrt    User?         @relation("PiloteGrt", fields: [piloteGrtId], references: [userId]) // Fixed relation
  deliverables Deliverable[]
  budgets      Budget[]
  tasks        Task[]
}

model Deliverable {
  deliverableId Int      @id @default(autoincrement())
  subActionId   Int
  file          String
  startDate     DateTime
  endDate       DateTime

  subAction  SubAction       @relation(fields: [subActionId], references: [subActionId])
  tasks      TaskLivrable[]
  // Livrable fields for frontend compatibility
  label       String?  // Alias for 'file' in frontend
  description String?
}

model Budget {
  budgetId       Int            @id @default(autoincrement())
  subActionId    Int
  category       BudgetCategory
  nature         String?
  quantity       Int?
  unit           String?
  avgUnitCostTtc Decimal?
  total          Decimal?

  subAction SubAction @relation(fields: [subActionId], references: [subActionId])
}

model Task {
  taskId      Int     @id @default(autoincrement())
  subActionId Int?    @map("sub_action_id")
  projectId   Int?    @map("project_id")
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  progress    Int      @default(0)
  parentId    Int?
  type        String   @default("task") // 'task', 'milestone', 'project'
  details     String?
  notes       String?
  files       String[] // JSON array
  goal        String?

  subAction       SubAction?       @relation(fields: [subActionId], references: [subActionId], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [projectId])
  taskAssignments TaskAssignment[]
  parent          Task?            @relation("TaskHierarchy", fields: [parentId], references: [taskId])
  children        Task[]           @relation("TaskHierarchy")
  linksSource     TaskLink[]       @relation("TaskSource")
  linksTarget     TaskLink[]       @relation("TaskTarget")
  livrables       TaskLivrable[]
}

model TaskAssignment {
  userId Int
  taskId Int

  user User @relation(fields: [userId], references: [userId])
  task Task @relation(fields: [taskId], references: [taskId])

  @@id([userId, taskId]) // Composite primary key
}

// Task Link model for Gantt chart dependencies
model TaskLink {
  linkId  Int @id @default(autoincrement())
  source Int
  target Int
  type   Int @default(0) // 0: finish-to-start, 1: start-to-start, etc.

  sourceTask Task @relation("TaskSource", fields: [source], references: [taskId])
  targetTask Task @relation("TaskTarget", fields: [target], references: [taskId])
}

// Task Livrable join table
model TaskLivrable {
  taskId     Int
  livrableId Int

  task     Task      @relation(fields: [taskId], references: [taskId])
  livrable Deliverable @relation(fields: [livrableId], references: [deliverableId])

  @@id([taskId, livrableId])
}

enum BudgetCategory {
  MOYENS_HUMAINS_INTERNES
  AMENAGEMENTS_MOBILIER
  EQUIPEMENTS_PEDAGOGIQUES
  PRESTATIONS
  COMMUNICATION_EVENEMENTIEL
}

// ==========================
// Type Models
// ==========================
model Type {
  typeId Int    @id @default(autoincrement())
  label  String

  questions Question[] @relation("TypeQuestion")
  projects  Project[]  @relation("ProjectType")
}

// ==========================
// Question & Response Models
// ==========================
model Question {
  questionId               Int      @id @default(autoincrement())
  label                    String
  keyword                  String   @default("Mot clé")
  category                 String
  numberOfSelectionableOpt Int?
  isRelevant               Boolean?
  hasMultipleOpenResponse  Boolean?
  shouldMultiply           Boolean?
  questionIdParent         Int?

  types     Type[]     @relation("TypeQuestion")
  options   Option[]
  responses Response[]
  projects  Project[]  @relation("ProjectQuestion")

  // Self relations
  parent   Question?  @relation("QuestionHierarchy", fields: [questionIdParent], references: [questionId])
  children Question[] @relation("QuestionHierarchy")
}

model Option {
  optionId   Int    @id @default(autoincrement())
  label      String
  questionId Int

  question Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  responses Response[]
}

model Response {
  responseId       Int     @id @default(autoincrement())
  label            String?
  keyword          String?
  projectId        Int
  questionId       Int
  optionId         Int?
  responseIdParent Int?

  project  Project  @relation(fields: [projectId], references: [projectId])
  question Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  option   Option?  @relation(fields: [optionId], references: [optionId])

  // Self relations
  parent   Response?  @relation("ResponseHierarchy", fields: [responseIdParent], references: [responseId])
  children Response[] @relation("ResponseHierarchy")
}
