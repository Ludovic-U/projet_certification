generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

// la config de l'app est un fichier json ..\backend\config\app-config.json

model User {
  userId    Int      @id @default(autoincrement())
  username  String   @unique
  firstname String
  lastname  String
  password  String?
  email     String   @unique
  createdAt DateTime @default(now())

  userSessions UserSession[]

  roles               UserRole[] // Existing relation
  clientUserRoles     ClientUserRole[] // Existing relation
}

model UserSession {
  sessionId Int      @id @default(autoincrement())
  userId    Int
  tokenHash String // Stocke le hash du token JWT
  createdAt DateTime @default(now())
  expiresAt DateTime
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model Client {
  clientId        Int              @id @default(autoincrement())
  clientName      String           @unique
  description     String?
  secteur         String?
  statusJuridique String?
  createdAt       DateTime         @default(now())
  projects        Project[]
  userRoles       ClientUserRole[]
}

model ClientUserRole {
  clientId  Int
  userId    Int
  isManager Boolean @default(false) //TODO: à changer
  position  String?

  client Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([clientId, userId]) // Composite primary key
}

model Role {
  roleId   Int     @id @default(autoincrement())
  roleName String  @unique
  roleDesc String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [userId])
  role Role @relation(fields: [roleId], references: [roleId])

  @@id([userId, roleId]) // Composite primary key
}

model Permission {
  permId   Int     @id @default(autoincrement())
  permName String  @unique
  permDesc String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId Int
  permId Int

  role       Role       @relation(fields: [roleId], references: [roleId])
  permission Permission @relation(fields: [permId], references: [permId])

  @@id([roleId, permId]) // Composite primary key
}

model Project {
  projectId      Int       @id @default(autoincrement())
  projectName    String    @unique
  startDate      DateTime? @default(now())
  endDate        DateTime?
  tasks          Task[]
  projectType    String
  projectProgress Int @default(0) 
  projectDesc    String?
  createdAt      DateTime  @default(now())
  projectNote    String?
  clientId       Int
  SWOT_strength     String?
  SWOT_weakness     String?
  SWOT_opportunity  String?
  SWOT_threat       String?

  client  Client   @relation(fields: [clientId], references: [clientId])

  types           Type[]            @relation("ProjectType")
  questions       Question[]        @relation("ProjectQuestion")
  responses       Response[]
  FinanceurProjet FinanceurProjet[]
}

model Financeur {
  financeurId     Int               @id @default(autoincrement())
  FinanceurName   String            @unique
  FinanceurProjet FinanceurProjet[]
}

// The FinanceurProjet model serves as a join table to associate projects with financeurs and specify the percentage of funding provided by each financeur.
model FinanceurProjet {
  pourcentage Int
  montant     Int
  projectId   Int
  financeurId Int

  project   Project   @relation(fields: [projectId], references: [projectId])
  financeur Financeur @relation(fields: [financeurId], references: [financeurId])

  @@id([projectId, financeurId]) // Composite primary key  
}

model Deliverable {
  deliverableId Int      @id @default(autoincrement())
  
  delivered     Boolean @default(false)
  uploaded      Boolean @default(false)
  filepath      String? 
  file          String
  startDate     DateTime
  endDate       DateTime

}

model Budget {
  budgetId       Int            @id @default(autoincrement())
  category       BudgetCategory
  nature         String?
  quantity       Int?
  unit           String?
  avgUnitCostTtc Decimal?
  total          Decimal?

}

model Task {
  taskId          Int         @id @default(autoincrement())
  taskName        String
  taskStart       DateTime    @default(now())
  taskEnd         DateTime
  parentId       Int?
  parent         Task? @relation("TaskHierarchy", fields: [parentId], references: [taskId])
  children        Task[] @relation("TaskHierarchy")
  taskParentId    Int      
  projectId       Int
  taskProject     Project       @relation(fields: [projectId], references : [projectId])
  taskType        String
  taskDesc        String?
  taskFiles       File[]
  taskDepenses    DepensesGantt[]
  taskEmployee    employeeGantt[]
  taskProgress    Int         @default(0)
  
  

}

model File {
  fileId          Int @id @default(autoincrement())
  taskId          Int
  taskFile        Task @relation(fields: [taskId], references: [taskId])
  
  name            String
  url             String
  size            Int
  mimeType        String

  uploadedAt      DateTime    @default(now())

}

model DepensesGantt {
  depenseId Int @id @default(autoincrement())
  taskId  Int
  depenseTask   Task  @relation(fields: [taskId], references: [taskId])
  depenseQte Int 
  depenseCost Int
  depenseType String

}

model employeeGantt {
  employeeId Int @id @default(autoincrement())
  taskId Int 
  employeeTask Task @relation(fields: [taskId], references: [taskId])
  employeeQte Int
  employeeCost Int
  employeeActor String?
  employeePilot String
  employeeNbd Int             @default(1)
  
}

