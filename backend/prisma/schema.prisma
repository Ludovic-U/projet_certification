generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId              Int                  @id @default(autoincrement())
  username            String               @unique
  firstname           String
  lastname            String
  password            String?
  email               String               @unique
  createdAt           DateTime             @default(now())
  clientUserRoles     ClientUserRole[]
  projects            Project[]            @relation("ProjectManager")
  subActionsPiloteGrt SubAction[]          @relation("PiloteGrt")
  assigneeDetails     TaskAssigneeDetail[]
  taskAssignments     TaskAssignment[]
  todos               Todo[]               @relation("TodoAssignments")
  roles               UserRole[]
  userSessions        UserSession[]
}

model UserSession {
  sessionId Int      @id @default(autoincrement())
  userId    Int
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ip        String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model Client {
  clientId        Int              @id @default(autoincrement())
  clientName      String           @unique
  statusJuridique String?
  secteur         String?
  description     String?
  createdAt       DateTime         @default(now())
  userRoles       ClientUserRole[]
  projects        Project[]
}

model ClientUserRole {
  clientId  Int
  userId    Int
  isManager Boolean @default(false)
  position  String?
  client    Client  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([clientId, userId])
}

model Role {
  roleId          Int              @id @default(autoincrement())
  roleName        String           @unique
  roleDesc        String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model UserRole {
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [roleId])
  user   User @relation(fields: [userId], references: [userId])

  @@id([userId, roleId])
}

model Permission {
  permId          Int              @id @default(autoincrement())
  permName        String           @unique
  permDesc        String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId     Int
  permId     Int
  permission Permission @relation(fields: [permId], references: [permId])
  role       Role       @relation(fields: [roleId], references: [roleId])

  @@id([roleId, permId])
}

model Project {
  projectId        Int               @id @default(autoincrement())
  projectName      String            @unique
  startDate        DateTime?
  endDate          DateTime?
  projectManager   Int
  projectStage     String?
  projectStatus    String?
  projectDesc      String?
  createdAt        DateTime          @default(now())
  clientId         Int
  goNogo           String?
  // SWOT fields
  SWOT_strength    String?
  SWOT_weakness    String?
  SWOT_opportunity String?
  SWOT_threat      String?
  actions          Action[]
  FinanceurProjet  FinanceurProjet[]
  mindmaps         Mindmap[]
  client           Client            @relation(fields: [clientId], references: [clientId])
  manager          User              @relation("ProjectManager", fields: [projectManager], references: [userId])
  responses        Response[]
  tasks            Task[]
  todos            Todo[]
  versions         Version[]
  questions        Question[]        @relation("ProjectQuestion")
  types            Type[]            @relation("ProjectType")
  decisions        ProjectDecision[]
  impacts          ProjectImpact[]
}

model Todo {
  todoId       Int       @id @default(autoincrement())
  text         String
  completed    Boolean   @default(false)
  projectId    Int
  assignedTo   Int?
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  assignedUser User?     @relation("TodoAssignments", fields: [assignedTo], references: [userId])
  project      Project   @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
}

model Financeur {
  financeurId     Int               @id @default(autoincrement())
  FinanceurName   String            @unique
  FinanceurProjet FinanceurProjet[]
}

model FinanceurProjet {
  projectId   Int
  financeurId Int
  pourcentage Int
  montant     Decimal?
  financeur   Financeur @relation(fields: [financeurId], references: [financeurId])
  project     Project   @relation(fields: [projectId], references: [projectId])

  @@id([projectId, financeurId])
}

model Action {
  actionId   Int         @id @default(autoincrement())
  actionName String
  actionObj  String?
  projectId  Int
  startDate  DateTime
  progress   Int         @default(0) // Calculated from subActions
  project    Project     @relation(fields: [projectId], references: [projectId])
  subActions SubAction[]
}

model SubAction {
  subActionId  Int           @id @default(autoincrement())
  actionId     Int
  description  String?
  piloteGrtId  Int?
  startDate    DateTime
  endDate      DateTime
  progress     Int           @default(0) // Calculated from tasks
  budgets      Budget[]
  deliverables Deliverable[]
  action       Action        @relation(fields: [actionId], references: [actionId])
  piloteGrt    User?         @relation("PiloteGrt", fields: [piloteGrtId], references: [userId])
  tasks        Task[]
}

model Deliverable {
  deliverableId Int       @id @default(autoincrement())
  subActionId   Int
  file          String
  startDate     DateTime
  endDate       DateTime
  subAction     SubAction @relation(fields: [subActionId], references: [subActionId])
  tasks         Task[]    @relation("TaskDeliverables")
}

model Budget {
  budgetId       Int            @id @default(autoincrement())
  subActionId    Int
  category       BudgetCategory
  nature         String?
  quantity       Int?
  unit           String?
  avgUnitCostTtc Decimal?
  total          Decimal?
  subAction      SubAction      @relation(fields: [subActionId], references: [subActionId])
}

model Task {
  taskId          Int                     @id @default(autoincrement())
  subActionId     Int?                    @map("sub_action_id")
  name            String
  description     String?
  projectId       Int?                    @map("project_id")
  details         String?
  endDate         DateTime?
  files           String[]
  goal            String?
  notes           String?
  parentId        Int?
  progress        Int                     @default(0)
  startDate       DateTime?
  type            String                  @default("task")
  versionId       Int?                    @map("version_id")
  color           String                  @default("#3b82f6")
  // Budget fields - JSON stored as string
  budget          String?                 @map("budget")
  parent          Task?                   @relation("TaskHierarchy", fields: [parentId], references: [taskId])
  children        Task[]                  @relation("TaskHierarchy")
  project         Project?                @relation(fields: [projectId], references: [projectId])
  subAction       SubAction?              @relation(fields: [subActionId], references: [subActionId])
  version         Version?                @relation(fields: [versionId], references: [versionId])
  assigneeDetails TaskAssigneeDetail[]
  taskAssignments TaskAssignment[]
  deliverables    TaskDeliverableStatus[]
  expenses        TaskExpense[]
  linksSource     TaskLink[]              @relation("TaskSource")
  linksTarget     TaskLink[]              @relation("TaskTarget")
  tasks           Deliverable[]           @relation("TaskDeliverables")

  @@index([projectId])
  @@index([versionId])
  @@index([parentId])
}

model TaskAssignment {
  userId Int
  taskId Int
  task   Task @relation(fields: [taskId], references: [taskId])
  user   User @relation(fields: [userId], references: [userId])

  @@id([userId, taskId])
}

model TaskLink {
  linkId     Int      @id @default(autoincrement())
  source     Int
  target     Int
  type       Int      @default(0)
  versionId  Int?
  sourceTask Task     @relation("TaskSource", fields: [source], references: [taskId])
  targetTask Task     @relation("TaskTarget", fields: [target], references: [taskId])
  version    Version? @relation(fields: [versionId], references: [versionId])

  @@index([source])
  @@index([target])
  @@index([versionId])
}

model TaskExpense {
  expenseId   Int      @id @default(autoincrement())
  taskId      Int
  category    String
  amount      Decimal
  date        DateTime
  description String?
  vendor      String?
  task        Task     @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId])
}

model TaskAssigneeDetail {
  id         Int    @id @default(autoincrement())
  taskId     Int
  userId     Int
  role       String @default("member")
  allocation Int    @default(100)
  task       Task   @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  user       User   @relation(fields: [userId], references: [userId])

  @@index([taskId])
  @@index([userId])
}

model TaskDeliverableStatus {
  id          Int       @id @default(autoincrement())
  taskId      Int
  name        String
  status      String    @default("pending")
  completedAt DateTime?
  notes       String?
  // New fields for file upload and confirmation
  fileUrl     String?
  fileName    String?
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  task        Task      @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId])
}

model Version {
  versionId   Int        @id @default(autoincrement())
  projectId   Int        @map("project_id")
  name        String
  description String?
  isActive    Boolean    @default(false) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  tasks       Task[]
  links       TaskLink[]
  mindmaps    Mindmap[]
  project     Project    @relation(fields: [projectId], references: [projectId])

  @@index([projectId])
}

model Type {
  typeId    Int        @id @default(autoincrement())
  label     String     @unique
  projects  Project[]  @relation("ProjectType")
  questions Question[] @relation("TypeQuestion")
}

model QuestionCategory {
  questionCategoryId Int        @id @default(autoincrement())
  label              String     @unique
  questions          Question[]
}

model Question {
  questionId               Int     @id @default(autoincrement())
  label                    String
  keyword                  String
  category                 String? //categorySWOT
  onglet                   String  @default("analyse_existant")
  numberOfSelectionableOpt Int?
  questionIdParent         Int?

  types     Type[]     @relation("TypeQuestion") // type de projet
  options   Option[]
  responses Response[]
  projects  Project[]  @relation("ProjectQuestion")

  // Self relations
  parent                             Question?         @relation("QuestionHierarchy", fields: [questionIdParent], references: [questionId])
  children                           Question[]        @relation("QuestionHierarchy")
  QuestionCategory                   QuestionCategory? @relation(fields: [questionCategoryQuestionCategoryId], references: [questionCategoryId])
  questionCategoryQuestionCategoryId Int?
}

model Option {
  optionId   Int        @id @default(autoincrement())
  label      String
  questionId Int
  question   Question   @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  responses  Response[]
}

model Response {
  responseId       Int        @id @default(autoincrement())
  label            String?
  keyword          String?
  projectId        Int
  questionId       Int
  optionId         Int?
  responseIdParent Int?
  option           Option?    @relation(fields: [optionId], references: [optionId])
  project          Project    @relation(fields: [projectId], references: [projectId])
  question         Question   @relation(fields: [questionId], references: [questionId])
  parent           Response?  @relation("ResponseHierarchy", fields: [responseIdParent], references: [responseId])
  children         Response[] @relation("ResponseHierarchy")
}

model Mindmap {
  mindmapId Int           @id @default(autoincrement())
  projectId Int           @map("project_id")
  versionId Int?          @map("version_id")
  name      String        @default("Untitled Mindmap")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  project   Project       @relation(fields: [projectId], references: [projectId], onDelete: Cascade)
  version   Version?      @relation(fields: [versionId], references: [versionId])
  edges     MindmapEdge[]
  nodes     MindmapNode[]

  @@index([projectId])
  @@index([versionId])
}

model MindmapNode {
  nodeId     Int      @id @default(autoincrement()) @map("node_id")
  mindmapId  Int      @map("mindmap_id")
  externalId String   @map("external_id")
  label      String
  nodeType   String   @map("node_type")
  positionX  Float    @map("position_x")
  positionY  Float    @map("position_y")
  color      String?
  fontSize   Int      @default(14) @map("font_size")
  isRoot     Boolean  @default(false) @map("is_root")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  mindmap    Mindmap  @relation(fields: [mindmapId], references: [mindmapId], onDelete: Cascade)

  @@unique([mindmapId, externalId])
  @@index([mindmapId])
}

model MindmapEdge {
  edgeId     Int      @id @default(autoincrement()) @map("edge_id")
  mindmapId  Int      @map("mindmap_id")
  externalId String   @map("external_id")
  source     String
  target     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  mindmap    Mindmap  @relation(fields: [mindmapId], references: [mindmapId], onDelete: Cascade)

  @@unique([mindmapId, externalId])
  @@index([mindmapId])
}

// Decision model for feasibility and strategic tracking
model ProjectDecision {
  decisionId     Int      @id @default(autoincrement()) @map("decision_id")
  projectId      Int      @map("project_id")
  // Board type: "faisabilite" or "strategique"
  boardType      String   @default("faisabilite") @map("board_type")
  // Decision type within the board
  decisionType   String   @map("decision_type")
  // Yes/No answer
  isApproved     Boolean? @map("is_approved")
  // Reason/Why text
  pourquoi       String?  @map("pourquoi")
  // Manual decision finale (go, nogo, pending) - user selected per board
  decisionFinale String?  @map("decision_finale")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  project        Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([projectId, boardType, decisionType])
  @@index([projectId])
}

// Impact model for tracking project impacts in ideation phase
model ProjectImpact {
  impactId          Int      @id @default(autoincrement()) @map("impact_id")
  projectId         Int      @map("project_id")
  // Impact row identifier (for ordering)
  rowOrder          Int      @default(0) @map("row_order")
  // 5 columns: Résultats Attendus, Critères, Indicateurs, Situation de Départ, Objectif
  resultatsAttendus String?  @map("resultats_attendus")
  criteres          String?  @map("criteres")
  indicateurs       String?  @map("indicateurs")
  situationDepart   String?  @map("situation_depart")
  objectif          String?  @map("objectif")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  project           Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId])
}

enum BudgetCategory {
  MOYENS_HUMAINS_INTERNES
  AMENAGEMENTS_MOBILIER
  EQUIPEMENTS_PEDAGOGIQUES
  PRESTATIONS
  COMMUNICATION_EVENEMENTIEL
}
